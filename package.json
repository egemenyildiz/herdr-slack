{
  "name": "herdr-slack",
  "version": "1.0.0",
  "private": true,
  "description": "Drive your local herdr agents from Slack — browse, prompt, approve, and launch agents from your phone.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egemenyildiz/herdr-slack.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "herdr-slack": "app/dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "prepare:dev": "lefthook install"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^1.10.0",
    "vitest": "^4.1.10"
  }
}
